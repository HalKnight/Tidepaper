<div class="page-header">
	<h1><i class="fa fa-envelope"></i> Messages</h1>
	<div class="message-actions">
		<a class="btn btn-primary" href="/messages/compose">
			<i class="fa fa-pencil"></i> New message
		</a>
		<a class="btn {{#unless readMessages}}btn-default message-action-active{{else}}btn-primary{{/unless}}" href="/messages">
			<i class="fa fa-inbox"></i> Inbox
		</a>
		<a class="btn {{#if readMessages}}btn-default message-action-active{{else}}btn-primary{{/if}}" href="/messages/read">
			<i class="fa fa-envelope-open"></i> Read messages
		</a>
	</div>
</div>

{{#if success_messages}}
<div class="alert alert-success">{{success_messages}}</div>
{{/if}}
{{#if error_messages}}
<div class="alert alert-danger">{{error_messages}}</div>
{{/if}}

{{#if messages.length}}
<div class="panel panel-default message-list">
	<div class="list-group">
		{{#each messages}}
		<div class="list-group-item{{#unless read}} message-unread{{/unless}}">
			<a class="message-link" href="/messages/{{_id}}">
				<div class="message-list-row">
					<div>
						<strong>{{subject}}</strong>
						{{#if attachment}}<i class="fa fa-paperclip" title="Has attachment"></i>{{/if}}
						<span class="message-sender">From {{senderName}}</span>
					</div>
					<small>{{timeago createdAt}}</small>
				</div>
				<p>{{body}}</p>
			</a>
			{{#if attachment}}
			<a class="btn btn-default btn-xs message-attachment-link" target="_blank" rel="noopener noreferrer" download="{{attachment.filename}}"
				href="/messages/{{_id}}/attachment">
				<i class="fa fa-download"></i> Download {{attachment.filename}}
			</a>
			{{/if}}
			<form method="post" action="/messages/{{_id}}/delete" class="message-delete-form">
				<input type="hidden" name="_csrf" value="{{../csrfToken}}">
				{{#unless ../readMessages}}
				<button type="submit" formaction="/messages/{{_id}}/read" class="btn btn-default btn-xs">
					<i class="fa fa-check"></i> Mark as read
				</button>
				{{/unless}}
				<button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('Delete this message?');">
					<i class="fa fa-trash"></i> Delete
				</button>
			</form>
		</div>
		{{/each}}
	</div>
</div>
{{else}}
<div class="empty-state">
	<i class="fa fa-inbox"></i>
	{{#if readMessages}}
	<h3>No read messages</h3>
	<p>Messages you have opened will appear here.</p>
	{{else}}
		<h3>Your inbox is empty</h3>
		<p>Unread messages from other Tidepaper users will appear here.</p>
	{{/if}}
</div>
{{/if}}
{{#if messageTotalPages}}
<div class="message-actions">
	{{#unless (eq messagePage 1)}}<a class="btn btn-default btn-xs" href="{{#if readMessages}}/messages/read{{else}}/messages{{/if}}?page={{messagePreviousPage}}">Previous</a>{{/unless}}
	<span class="text-muted">Page {{messagePage}} of {{messageTotalPages}}</span>
	{{#if (eq messagePage messageTotalPages)}}{{else}}<a class="btn btn-default btn-xs" href="{{#if readMessages}}/messages/read{{else}}/messages{{/if}}?page={{messageNextPage}}">Next</a>{{/if}}
</div>
{{/if}}
