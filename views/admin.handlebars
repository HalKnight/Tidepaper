<!DOCTYPE html>
<div class="container">

	<div class="page-header text-center">
		<h1>
			<span class="fa"></span> Users
		</h1>
	</div>
	{{#each users}}
	<div class="row">
		<div class="col-sm-6">
      <div style="float: left">
				<a class="btn btn-primary btn-xs"
					href="/editProfileAdmin/{{ local.email }}">Edit</a>
			</div>
			<div style="float: left; margin-left: 4px">
				<form action="/admin/users/delete" method="post" style="display: inline;"
					onsubmit="return confirm('Delete this user and all of their articles and comments?');">
					<input type="hidden" name="_csrf" value="{{../csrfToken}}">
					<input type="hidden" name="userEmail" value="{{ local.email }}">
					<select name="deleteArticles" class="input-sm" title="Article handling">
						<option value="keep">Keep articles</option>
						<option value="delete">Delete articles</option>
					</select>
					<button class="btn btn-danger btn-xs" type="submit">Delete</button>
				</form>
			</div>
			<div class="well">
				<h3>
					<span class="fa fa-user">&nbsp;:&nbsp;{{local.name}}</span>
				</h3>

				<p>
					<i class="fa fa-envelope" aria-hidden="true"></i>&nbsp;:&nbsp;{{local.email}}<br>
				</p>

			</div>
		</div>

	</div>
	{{/each}}
</div>
