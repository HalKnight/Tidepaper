<!DOCTYPE html>
<html>
<head>
<title>{{lama.header}} settings</title>
<style>
body {
	padding-top: 80px;
}
</style>
</head>
<body>
	<div class="container">

		<div class="col-sm-6 col-sm-offset-3">

			<h1>
				<span class="fa"></span> Settings
			</h1>

			{{#if messages}}
			<div class="alert alert-danger">{{message}}</div>
			{{/if}}

			<form action="/settings" method="post" enctype="multipart/form-data">
				<input type="hidden" name="_csrf" value="{{csrfToken}}">

				<hr>
				<div class="form-group">
					<label>Blog header</label> <input type="text" class="form-control"
						name="header" value="{{settings.header}}">
				</div>
				<div class="form-group">
					<label>Tidepaper icon destination</label> <input type="text" class="form-control"
						name="tidepaperUrl" value="{{settings.tidepaperUrl}}" placeholder="https://example.com">
					<small class="help-block">The TP icon can link to an internal or external URL.</small>
				</div>
				<div class="form-group">
					<label>Tidepaper icon image URL</label> <input type="text" class="form-control"
						name="tidepaperIconUrl" value="{{settings.tidepaperIconUrl}}" placeholder="/public/upload/tidepaper-icon.png">
					<small class="help-block">Leave blank to use the default TP icon.</small>
				</div>
				<div class="form-group">
					<label>Upload Tidepaper icon</label>
					<input type="file" name="tidepaperIconFile" class="form-control" accept=".png,.jpg,.jpeg,.gif">
					<small class="help-block">Optional. PNG, JPG, or GIF. Maximum 2 MB. The image is moderated before saving.</small>
				</div>
				<div class="form-group">
					<label>
						<input type="checkbox" name="useDefaultTidepaperIcon">
						 Use the default TP icon
					</label>
				</div>
				<div class="form-group">
					<label>Allow New Users</label> <input style="width: 10%;"
						type="checkbox" class="form-control" name="newUsers" {{#if settings.newUsers }}checked{{/if}}>
				</div>
				<div class="form-group">
					<label>Theme</label>
				</div>
				<div class="form-group">
					<input type="radio" name="theme" value="readable" {{#if (eq settings.theme "readable")}} checked {{/if}}>
					<a target="_blank" href="https://bootswatch.com/3/readable/">Readable</a><br>
					<input type="radio" name="theme" value="slate" {{#if (eq settings.theme "slate")}} checked {{/if}}> <a
						target="_blank" href="https://bootswatch.com/3/slate/">Slate</a><br>
					<input type="radio" name="theme" value="flatly" {{#if (eq settings.theme "flatly")}} checked {{/if}}> <a
						target="_blank" href="https://bootswatch.com/3/flatly/">Flatly</a><br>
					<input type="radio" name="theme" value="united" {{#if (eq settings.theme "united")}} checked {{/if}}> <a
						target="_blank" href="https://bootswatch.com/3/united/">United</a><br>
					<input type="radio" name="theme" value="cyborg" {{#if (eq settings.theme "cyborg")}} checked {{/if}}> <a
						target="_blank" href="https://bootswatch.com/3/cyborg/">Cyborg</a><br>
					<input type="radio" name="theme" value="solar" {{#if (eq settings.theme "solar")}} checked {{/if}}> <a
						target="_blank" href="https://bootswatch.com/3/solar/">Solar</a><br>
				</div>
				<div class="form-group">
					<label>Image moderation</label>
					<select name="moderationProvider" class="form-control">
						<option value="local" {{#if (eq settings.moderationProvider "local")}}selected{{/if}}>Local NSFWJS (default)</option>
						<option value="aws" {{#if (eq settings.moderationProvider "aws")}}selected{{/if}}>AWS Rekognition</option>
						<option value="google" {{#if (eq settings.moderationProvider "google")}}selected{{/if}}>Google Cloud Vision SafeSearch</option>
						<option value="azure" {{#if (eq settings.moderationProvider "azure")}}selected{{/if}}>Azure AI Content Safety</option>
					</select>
					<small class="help-block">Local mode has no API fee. Cloud modes require their provider credentials and adapters.</small>
				</div>
				<button type="submit" class="btn btn-warning btn-lg">Update</button>
			</form>

			<hr>

		</div>

	</div>
</body>
</html>