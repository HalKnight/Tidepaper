<!DOCTYPE html>
<html lang="en">
<head>
<title>{{lama.header}}</title>
<meta name="csrf-token" content="{{csrfToken}}">
{{#each styleSheet}}
	<link href="{{css}}" rel="stylesheet">
{{/each}}
<link href="/public/css/font-awesome.css" rel="stylesheet">
<link rel="stylesheet" type="text/css" href="/public/css/styles.css?v=3.4.0">
<link rel="stylesheet" type="text/css" href="/public/css/editor.css">
</head>

<body class="theme-{{theme}}">
	<header class="app-header">
		<div class="container">
			<div class="app-bar">
				<a class="app-brand" href="/home">{{lama.header}}</a>
				{{#unless stats.stat}}
				<button class="hamburger" type="button" title="Show or hide the sidebar" aria-label="Show or hide the sidebar" aria-expanded="true">&#9776;</button>
				{{/unless}}
			</div>
			<nav class="app-nav" aria-label="Main navigation">
				<a class="btn btn-primary btn-xs homeButton" href="/home">Home</a>
				<a class="btn btn-primary btn-xs newArticleButton" href="/newArticle">Create</a>
				<a class="btn btn-primary btn-xs" href="/profile">Profile</a>
				<a class="btn btn-primary btn-xs" href="/my-posts">My Posts</a>
				<a class="btn btn-primary btn-xs" href="/messages">
					<i class="fa fa-envelope"></i> Messages
					{{#if unreadMessages}}<span class="message-alert" title="Unread messages" aria-label="{{unreadMessages}} unread messages"><i class="fa fa-bell"></i> {{unreadMessages}}</span>{{/if}}
				</a>
				<a class="btn btn-primary btn-xs" href="/messages/compose"><i class="fa fa-pencil"></i> New message</a>
				{{#if user.local.admin}}
				<a class="btn btn-primary btn-xs" href="/admin">Admin</a>
				<a class="btn btn-primary btn-xs" href="/settings">Settings</a>
				{{/if}}
				<form action="/logout" method="post">
					<input type="hidden" name="_csrf" value="{{csrfToken}}">
					<button class="btn btn-primary btn-xs" type="submit">Logout</button>
				</form>
			</nav>
		</div>
	</header>
	<main class="app-content">
		<div class="container">
			<div class="row">
				{{#unless stats.stat}}
				<div class="col-sm-8 mainBlog">{{{body}}}</div>
				<div class="col-sm-4 stats sidebar-visible">{{> stats this }} {{> popular this
					}} {{> comments this }} {{> searchByAuthor this }} {{> searchByDate this }}</div>
				{{/unless}} {{#if stats.stat}}
				<div class="col-sm-12">{{{body}}}</div>
				{{/if}}
			</div>
		</div>
	</main>
	<footer class="app-footer">
		<div class="container">
			<div class="row">
				<div class="col-sm-12 text-center">
					<p class="text-muted">{{{lama.version}}}</p>
					<p class="text-center">
						<a target="_blank" rel="noopener noreferrer" aria-label="X" href="{{lama.twitter}}"><span
							class="x-logo" aria-hidden="true">X</span></a> <a
							 target="_blank" href="{{lama.facebook}}"><i
							class="fa fa-facebook-square fa-2x text-primary"></i></a>
					</p>
				</div>
			</div>
		</div>
	</footer>
  <!-- Search-Modal -->
<div class="modal fade" id="searchArticlesModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLongTitle">Modal title</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        .<p>
          No Records Found
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
	<script src="/public/js/jquery-3.2.1.js"></script>
	<script type="text/javascript" src="/public/js/scripts.js?v=3.4.0"></script>
	<script type="text/javascript" src="/public/js/bootstrap.js"></script>
	<script type="text/javascript" src="/public/js/editor.js"></script>
	{{#each scripts}}
	<script src="{{script}}"></script>
	{{/each}}
</body>
</html>